{
  "name": "flashy",
  "version": "0.1.0",
  "description": "浏览器端 ESP32 固件烧录工具（基于 Web Serial + esptool-js）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint",
    "check:fix": "pnpm run typecheck && pnpm run lint:fix && pnpm run format",
    "spellcheck": "cspell \"**/*.ts\" \"**/*.md\" \"**/*.html\" \"**/*.css\"",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shenjingnan/flashy.git"
  },
  "bugs": {
    "url": "https://github.com/shenjingnan/flashy/issues"
  },
  "homepage": "https://github.com/shenjingnan/flashy#readme",
  "dependencies": {
    "esptool-js": "^0.6.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^25.5.0",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitest/coverage-v8": "^3.2.0",
    "cspell": "^10.0.1",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^6.0.2",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": ">=5.3.0",
      "undici": ">=6.24.0"
    }
  }
}
